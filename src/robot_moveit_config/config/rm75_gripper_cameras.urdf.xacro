<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm75_gripper_cameras">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_fake_hardware" default="true" />
    <xacro:arg name="use_gazebo" default="false" />
    <xacro:arg name="gazebo_controllers_file" default="" />

    <!-- Import rm75_gripper_cameras urdf file -->
    <xacro:include filename="$(find robot_gazebo_sim)/urdf/robot_system.urdf.xacro" />

    <!-- ros2_control for MoveIt2 fake hardware demo (mock hardware) -->
    <xacro:if value="$(arg use_fake_hardware)">
        <xacro:include filename="rm75_gripper_cameras.ros2_control.xacro" />
        <xacro:rm75_gripper_cameras_ros2_control 
            name="FakeSystem" 
            initial_positions_file="$(arg initial_positions_file)"/>
    </xacro:if>

    <!-- ros2_control for Gazebo simulation -->
    <xacro:if value="$(arg use_gazebo)">
        <xacro:include filename="rm75_gripper_cameras.gazebo_ros2_control.xacro" />
        <xacro:rm75_gripper_cameras_gazebo_ros2_control 
            controllers_file="$(arg gazebo_controllers_file)"/>
    </xacro:if>

    <gazebo>
        <plugin name="gazebo_grasp_fix" filename="libgazebo_grasp_fix.so">
        <arm>
            <arm_name>robot_gripper</arm_name>
            <palm_link>Link7</palm_link>
            <gripper_link>gripper_finger1_link</gripper_link>
            <gripper_link>gripper_finger1_link2</gripper_link>
            <gripper_link>gripper_finger1_tip_link</gripper_link>
            <gripper_link>gripper_finger2_link</gripper_link>
            <gripper_link>gripper_finger2_link3</gripper_link>
            <gripper_link>gripper_finger2_tip_link</gripper_link>
        </arm>
        <forces_angle_tolerance>100</forces_angle_tolerance>
        <update_rate>10</update_rate>
        <grip_count_threshold>2</grip_count_threshold>
        <max_grip_count>4</max_grip_count>
        <release_tolerance>0.03</release_tolerance>
        <disable_collisions_on_attach>true</disable_collisions_on_attach>
        <contact_topic>__default_topic__</contact_topic>
        </plugin>
    </gazebo>
</robot>
